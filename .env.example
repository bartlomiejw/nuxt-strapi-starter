# Copy to `.env` and adjust. Every variable is optional for local development.

# Strapi URL used by the Nuxt server (SSR + /api routes). In Docker use the service name.
NUXT_STRAPI_URL=http://localhost:1337
# Optional read-only Strapi API token (server-side only, never sent to the browser).
NUXT_STRAPI_TOKEN=
# Strapi URL as seen by the browser, used to build media URLs.
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Canonical site URL (SEO: canonical/hreflang/og:url).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry: leave the DSN empty to disable Sentry completely.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time only: upload source maps when all three are set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
