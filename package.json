{
  "name": "nuxt-strapi-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-minded Nuxt 4 + Strapi 5 starter with PrimeVue, Tailwind CSS, i18n (incl. RTL), Sentry and a full test/CI setup.",
  "license": "MIT",
  "author": "Bartłomiej Warias",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartlomiejw/nuxt-strapi-starter.git"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@dargmuesli/nuxt-cookie-control": "^9.3.10",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@primeuix/themes": "~2.0.3",
    "@primevue/nuxt-module": "~4.5.5",
    "@sentry/nuxt": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.6.2",
    "ofetch": "^1.5.1",
    "pinia": "^4.1.0",
    "primevue": "~4.5.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
